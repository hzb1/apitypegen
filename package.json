{
  "name": "ts-swagger",
  "version": "0.7.0",
  "private": false,
  "type": "module",
  "bin": {
    "ts-swagger": "./bin/ts-swagger.mjs"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:glitchtip:cli": "npm run build && npm run sourcemaps:upload:cli",
    "deploy:extension": "bash scripts/deploy-extension.sh",
    "deploy:ui": "bash scripts/deploy-ui.sh",
    "glitchtip:test:cli": "npm run build && node ./scripts/send-cli-glitchtip-test.mjs",
    "sourcemaps:upload:cli": "bash scripts/upload-cli-sourcemaps.sh",
    "test:core": "npm run build && node --test tests/swagger-loader.test.mjs tests/openapi-cache.test.mjs tests/cli.test.mjs tests/cli-presenters.test.mjs tests/cli-telemetry.test.mjs",
    "test:browser": "npm run build && node --test tests/browser-discovery.test.mjs",
    "typecheck:core": "tsc -p tsconfig.build.json --noEmit",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "ts-swagger": "node ./dist/cli/ts-swagger.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "ts-swagger.config.example.json"
  ],
  "devDependencies": {
    "@sentry/cli": "^2.58.6",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@sentry/node": "^10.71.0",
    "playwright-core": "^1.62.1"
  }
}
