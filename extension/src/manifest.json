{
  "manifest_version": 4,
  "name": "APITypeGen Proxy",
  "version": "0.5.2",
  "description": "为 APITypeGen 代理跨域接口文档与调试请求",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "webRequest"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
