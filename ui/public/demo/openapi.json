{
  "openapi": "3.0.3",
  "info": {
    "title": "TS Swagger Demo API",
    "description": "A local demo OpenAPI document for trying TS Swagger without a browser extension.",
    "version": "0.5.2"
  },
  "servers": [
    {
      "url": "https://demo.ts-swagger.local/api",
      "description": "Demo server"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Login and session APIs"
    },
    {
      "name": "Users",
      "description": "User profile APIs"
    },
    {
      "name": "Orders",
      "description": "Order management APIs"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Password login",
        "description": "Create an access token with an account and password.",
        "operationId": "loginWithPassword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/profile": {
      "get": {
        "tags": ["Auth"],
        "summary": "Current profile",
        "description": "Get the current signed-in user's profile.",
        "operationId": "getCurrentProfile",
        "responses": {
          "200": {
            "description": "Current user profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Search users",
        "description": "Search users by keyword, status, and pagination options.",
        "operationId": "searchUsers",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "Search by name, email, or mobile phone.",
            "schema": {
              "type": "string",
              "example": "alice"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/UserStatus"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paged users",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPage"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Create user",
        "description": "Create a new user profile.",
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          }
        }
      }
    },
    "/users/{userId}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get user detail",
        "description": "Get a user profile by id.",
        "operationId": "getUserById",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "User id",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 9007199254740991
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "List orders",
        "description": "List orders for the current tenant.",
        "operationId": "listOrders",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/OrderStatus"
            }
          },
          {
            "name": "createdAfter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2026-06-01T00:00:00Z"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/orders/{orderId}/cancel": {
      "post": {
        "tags": ["Orders"],
        "summary": "Cancel order",
        "description": "Cancel an order with a reason.",
        "operationId": "cancelOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 1000000000123
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelOrderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cancel result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderSummary"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserStatus": {
        "type": "string",
        "description": "User account status",
        "enum": ["active", "disabled", "pending"]
      },
      "OrderStatus": {
        "type": "string",
        "description": "Order lifecycle status",
        "enum": ["created", "paid", "shipped", "cancelled"]
      },
      "LoginRequest": {
        "type": "object",
        "required": ["account", "password"],
        "properties": {
          "account": {
            "type": "string",
            "description": "Email or mobile phone.",
            "example": "alice@example.com"
          },
          "password": {
            "type": "string",
            "description": "Raw password entered by the user.",
            "example": "correct-horse-battery-staple"
          },
          "rememberMe": {
            "type": "boolean",
            "description": "Whether to keep the session active.",
            "example": true
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["accessToken", "expiresIn", "profile"],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Bearer token for API requests.",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int32",
            "description": "Token lifetime in seconds.",
            "example": 7200
          },
          "profile": {
            "$ref": "#/components/schemas/UserProfile"
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": ["name", "email"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name.",
            "example": "Alice Chen"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Login email.",
            "example": "alice@example.com"
          },
          "roleIds": {
            "type": "array",
            "description": "Assigned role ids.",
            "items": {
              "type": "integer",
              "format": "int64",
              "example": 2000000000001
            }
          },
          "profile": {
            "$ref": "#/components/schemas/UserProfileDraft"
          }
        }
      },
      "UserProfileDraft": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "example": "Alice"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          }
        }
      },
      "UserProfile": {
        "type": "object",
        "required": ["id", "name", "email", "status", "roles"],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Snowflake user id.",
            "example": 9007199254740991
          },
          "name": {
            "type": "string",
            "example": "Alice Chen"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "alice@example.com"
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          }
        }
      },
      "UserPage": {
        "type": "object",
        "required": ["total", "items"],
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Total matched users.",
            "example": 128
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserProfile"
            }
          }
        }
      },
      "Role": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 2000000000001
          },
          "name": {
            "type": "string",
            "example": "Admin"
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "example": "CN"
          },
          "city": {
            "type": "string",
            "example": "Shanghai"
          },
          "street": {
            "type": "string",
            "example": "No. 100 Century Avenue"
          }
        }
      },
      "OrderSummary": {
        "type": "object",
        "required": ["id", "orderNo", "status", "items", "amount"],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1000000000123
          },
          "orderNo": {
            "type": "string",
            "example": "SO202606220001"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "OrderItem": {
        "type": "object",
        "required": ["sku", "name", "quantity"],
        "properties": {
          "sku": {
            "type": "string",
            "example": "TSWAGGER-PRO"
          },
          "name": {
            "type": "string",
            "example": "TS Swagger Pro License"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "example": 2
          }
        }
      },
      "Money": {
        "type": "object",
        "required": ["currency", "value"],
        "properties": {
          "currency": {
            "type": "string",
            "example": "CNY"
          },
          "value": {
            "type": "number",
            "format": "double",
            "example": 199.99
          }
        }
      },
      "CancelOrderRequest": {
        "type": "object",
        "required": ["reason"],
        "properties": {
          "reason": {
            "type": "string",
            "description": "Business reason for cancelling the order.",
            "example": "Customer requested cancellation"
          },
          "notifyCustomer": {
            "type": "boolean",
            "description": "Whether to send a cancellation notification.",
            "example": true
          }
        }
      }
    }
  }
}
