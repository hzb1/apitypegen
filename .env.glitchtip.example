# GlitchTip sourcemap shared configuration.
# Copy this file to .env.glitchtip.local and fill in SENTRY_AUTH_TOKEN.
SENTRY_URL=https://monitor.huzhibin.top
# SENTRY_AUTH_TOKEN=replace-with-a-new-token

# UI sourcemap upload configuration (ts-swagger organization, project ID 3).
UI_SENTRY_ORG=ts-swagger
UI_SENTRY_PROJECT=3
UI_SOURCEMAP_URL_PREFIX=https://swagger.huzhibin.top/assets/

# CLI 匿名错误上报默认关闭，启用后默认发送至 ts-swagger/cli 项目。
# TS_SWAGGER_TELEMETRY=1
# 私有部署或测试环境可以覆盖内置 DSN：
# TS_SWAGGER_GLITCHTIP_DSN=https://public-key@monitor.example.com/project-id

# CLI sourcemap upload configuration (ts-swagger/cli).
CLI_SENTRY_ORG=ts-swagger
CLI_SENTRY_PROJECT=cli
CLI_SOURCEMAP_URL_PREFIX=app:///dist
