{
  "name": "@hzb1/apitypegen",
  "version": "0.9.0",
  "description": "从 API 文档生成可靠的 TypeScript 类型",
  "keywords": [
    "openapi",
    "swagger",
    "typescript",
    "code-generator",
    "cli",
    "mcp",
    "knife4j"
  ],
  "author": "hzb1",
  "license": "ISC",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzb1/apitypegen.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/hzb1/apitypegen#readme",
  "bugs": {
    "url": "https://github.com/hzb1/apitypegen/issues"
  },
  "bin": {
    "apitypegen": "bin/apitypegen.mjs"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "npm run build && node --test tests/swagger-loader.test.mjs tests/source-inspector.test.mjs tests/openapi-cache.test.mjs tests/cli.test.mjs tests/cli-presenters.test.mjs tests/cli-telemetry.test.mjs tests/mcp.test.mjs",
    "test:browser": "npm run build && node --test tests/browser-discovery.test.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:browser",
    "apitypegen": "node ./dist/cli/apitypegen.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "apitypegen.config.example.json"
  ],
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentry/node": "^10.71.0",
    "playwright-core": "^1.62.1",
    "zod": "^4.4.3"
  }
}
